# Copy this file to .env and add your own local credentials.
NODE_ENV=development
PORT=3000

# PostgreSQL connection for skill_nexa_db
DB_HOST=127.0.0.1
DB_PORT=1793
DB_NAME=skill_nexa_db
DB_USER=postgres
DB_PASS=your-local-postgres-password
DB_SSL=false

# Session security (replace this value with a long random secret)
SESSION_SECRET=replace-with-a-long-random-secret

# Links sent by verification and password-reset emails
APP_URL=http://localhost:3000

# Optional Gmail SMTP settings. When blank in development, email links
# are printed in the terminal for local testing. Use a Google App Password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM=
