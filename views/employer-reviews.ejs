
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | Skill Nexa</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 30px 20px;
            font-family: Arial, sans-serif;
            background: #f4f6f9;
            color: #263238;
        }

        .container {
            max-width: 900px;
            margin: 0 auto;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 15px;
            margin-bottom: 25px;
        }

        h1 {
            margin: 0 0 8px;
        }

        .company-name {
            color: #64748b;
            margin: 0;
        }

        .back-link {
            display: inline-block;
            padding: 10px 16px;
            background: #263b80;
            color: white;
            text-decoration: none;
            border-radius: 6px;
        }

        .review-card {
            background: white;
            padding: 22px;
            margin-bottom: 16px;
            border-radius: 10px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
        }

        .review-top {
            display: flex;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 10px;
        }

        .reviewer {
            font-weight: bold;
            font-size: 16px;
        }

        .rating {
            color: #d18b00;
            font-weight: bold;
        }

        .comment {
            line-height: 1.6;
            margin: 16px 0;
            overflow-wrap: anywhere;
        }

        .date {
            color: #77818d;
            font-size: 13px;
        }

        .empty-state {
            background: white;
            padding: 35px;
            border-radius: 10px;
            text-align: center;
        }
    </style>
</head>

<body>
    <main class="container">

        <header class="header">
            <div>
                <h1>Company Reviews</h1>
                <p class="company-name"><%= company.name %></p>
            </div>

            <a href="/employer" class="back-link">
                Back to Dashboard
            </a>
        </header>

        <section>
            <% if (reviews && reviews.length > 0) { %>

                <p>Total Reviews: <strong><%= reviews.length %></strong></p>

                <% reviews.forEach(function(review) { %>
                    <article class="review-card">

                        <div class="review-top">
                            <span class="reviewer">
                                <%= review.reviewerName %>
                            </span>

                            <span class="rating">
                                <%= review.rating %> / 5 Stars
                            </span>
                        </div>

                        <p class="comment"><%= review.comment %></p>

                        <p class="date">
                            Reviewed on:
                            <%= new Date(review.createdAt).toLocaleDateString() %>
                        </p>

                    </article>
                <% }); %>

            <% } else { %>

                <div class="empty-state">
                    <h2>No Reviews Yet</h2>
                    <p>Your company has not received any reviews yet.</p>
                </div>

            <% } %>
        </section>

    </main>
</body>
</html>
