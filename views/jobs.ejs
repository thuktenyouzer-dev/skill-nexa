<%- include('partials/header', { title }) %>

<section class="section">
  <h1>Find Jobs</h1>
  <p>Search current vacancies stored in the Skill Nexa database.</p>

  <form class="search-form search-form-compact" action="/jobs" method="GET">
    <label for="q">Job title, keyword or company</label>
    <div class="search-controls">
      <input id="q" name="q" type="search" placeholder="e.g. Web Developer" value="<%= filters.q %>" />
    </div>

    <div class="filter-grid">
      <div>
        <label for="location">Location</label>
        <input id="location" name="location" type="text" placeholder="e.g. Thimphu" value="<%= filters.location %>" />
      </div>
      <div>
        <label for="category">Category</label>
        <select id="category" name="category">
          <option value="">All categories</option>
          <% categories.forEach((item) => { %>
            <option value="<%= item.category %>" <%= filters.category === item.category ? 'selected' : '' %>><%= item.category %></option>
          <% }) %>
        </select>
      </div>
      <div>
        <label for="job_type">Employment type</label>
        <select id="job_type" name="job_type">
          <option value="">All types</option>
          <% ['Full-time', 'Part-time', 'Contract', 'Internship', 'Temporary'].forEach((type) => { %>
            <option value="<%= type %>" <%= filters.job_type === type ? 'selected' : '' %>><%= type %></option>
          <% }) %>
        </select>
      </div>
    </div>

    <div class="search-controls filter-actions">
      <button type="submit">Search jobs</button>
      <a class="btn-clear" href="/jobs">Clear filters</a>
    </div>
  </form>

  <p class="result-summary"><%= jobs.length %> available job(s)</p>

  <% if (jobs.length > 0) { %>
    <div class="job-grid">
      <% jobs.forEach((job) => { %>
        <article class="job-card">
          <h2><a href="/jobs/<%= job.id %>"><%= job.title %></a></h2>
          <p><strong><%= job.company_name %></strong></p>
          <p><%= job.location %></p>
          <p class="job-meta"><%= job.category %> · <%= job.job_type %> · <%= job.experience_level %></p>
          <% if (job.salary_min != null || job.salary_max != null) { %>
            <p class="job-meta">
              <%= job.salary_currency || 'BTN' %>
              <%= job.salary_min != null ? Number(job.salary_min).toLocaleString() : 'Not specified' %>
              –
              <%= job.salary_max != null ? Number(job.salary_max).toLocaleString() : 'Not specified' %>
            </p>
          <% } %>
          <a class="text-link" href="/jobs/<%= job.id %>">View details →</a>
        </article>
      <% }) %>
    </div>
  <% } else { %>
    <div class="empty-state">
      <h2>No jobs found</h2>
      <p>Try another keyword, location, category or employment type.</p>
      <a href="/jobs">Show all jobs</a>
    </div>
  <% } %>
</section>

<%- include('partials/footer') %>
