
<%- include('partials/header', { title: typeof title !== 'undefined' ? title : 'Skill Nexa' }) %>

<%
const featuredJobsList = typeof featuredJobs !== 'undefined' ? featuredJobs : [];
const latestJobsList = typeof latestJobs !== 'undefined' ? latestJobs : [];
const popularJobsList = typeof popularJobs !== 'undefined' ? popularJobs : [];
const categoriesList = typeof categories !== 'undefined' ? categories : [];
const companiesList = typeof companies !== 'undefined' ? companies : [];
%>

<!-- HERO SECTION -->
<section class="hero">
  <p class="eyebrow">Your career starts here</p>

  <h1>Discover Your Next Career Opportunity</h1>

  <p>
    Explore real vacancies from companies and find a role that matches
    your skills, qualifications and interests.
  </p>

  <form class="search-form" action="/jobs" method="GET">
    <label for="q">Search by job title, keyword or company</label>

    <div class="search-controls">
      <input
        id="q"
        name="q"
        type="search"
        placeholder="e.g. Web Developer"
      />

      <button type="submit">Search Jobs</button>
    </div>
  </form>

  <a class="btn-secondary" href="/jobs">
    Browse All Available Jobs
  </a>
</section>

<!-- FEATURED JOBS -->
<section class="section">
  <div class="section-heading">
    <h2>Featured Opportunities</h2>
    <a href="/jobs">View All Jobs →</a>
  </div>

  <% if (featuredJobsList.length > 0) { %>
    <div class="job-grid">

      <% featuredJobsList.forEach((job) => { %>
        <article class="job-card">

          <h3>
            <a href="/jobs/<%= job.id %>">
              <%= job.title %>
            </a>
          </h3>

          <p><strong><%= job.company_name %></strong></p>
          <p><%= job.location %></p>

          <p class="job-meta">
            <%= job.category %> · <%= job.job_type %>
          </p>

          <a class="text-link" href="/jobs/<%= job.id %>">
            View Details →
          </a>

        </article>
      <% }) %>

    </div>
  <% } else { %>

    <p class="empty-state">
      No featured jobs are available right now.
    </p>

  <% } %>
</section>

<!-- LATEST JOBS -->
<section class="section">
  <div class="section-heading">
    <h2>Latest Opportunities</h2>
    <a href="/jobs">Explore All Jobs →</a>
  </div>

  <% if (latestJobsList.length > 0) { %>
    <div class="job-grid">

      <% latestJobsList.forEach((job) => { %>
        <article class="job-card">

          <h3>
            <a href="/jobs/<%= job.id %>">
              <%= job.title %>
            </a>
          </h3>

          <p><strong><%= job.company_name %></strong></p>
          <p><%= job.location %></p>

          <a class="text-link" href="/jobs/<%= job.id %>">
            View Details →
          </a>

        </article>
      <% }) %>

    </div>
  <% } else { %>

    <p class="empty-state">
      There are no recent vacancies to display.
    </p>

  <% } %>
</section>

<!-- POPULAR JOBS -->
<section class="section">
  <h2>Popular Right Now</h2>

  <% if (popularJobsList.length > 0) { %>
    <div class="job-grid">

      <% popularJobsList.forEach((job) => { %>
        <article class="job-card">

          <h3>
            <a href="/jobs/<%= job.id %>">
              <%= job.title %>
            </a>
          </h3>

          <p><strong><%= job.company_name %></strong></p>
          <p><%= job.location %></p>

          <p class="job-meta">
            <%= job.applications_count %> application(s)
          </p>

          <a class="text-link" href="/jobs/<%= job.id %>">
            View Details →
          </a>

        </article>
      <% }) %>

    </div>
  <% } else { %>

    <p class="empty-state">
      Popular jobs will appear here when vacancies are available.
    </p>

  <% } %>
</section>

<!-- CAREER CATEGORIES -->
<section class="section">
  <h2>Explore Career Areas</h2>

  <% if (categoriesList.length > 0) { %>
    <div class="category-list">

      <% categoriesList.forEach((item) => { %>
        <a
          class="category-chip"
          href="/jobs?category=<%= encodeURIComponent(item.category) %>"
        >

          <span><%= item.category %></span>

          <span class="category-count">
            <%= item.total %>
          </span>

        </a>
      <% }) %>

    </div>
  <% } else { %>

    <p class="empty-state">
      Career areas will appear when jobs are added.
    </p>

  <% } %>
</section>

<!-- COMPANIES -->
<section class="section">
  <h2>Companies on Skill Nexa</h2>

  <% if (companiesList.length > 0) { %>
    <div class="company-grid">

      <% companiesList.forEach((company) => { %>
        <article class="company-card">

          <h3><%= company.name %></h3>

          <p><%= company.industry %></p>
          <p><%= company.location %></p>

          <p>
            <strong><%= company.active_jobs %></strong>
            active job(s)
          </p>

        </article>
      <% }) %>

    </div>
  <% } else { %>

    <p class="empty-state">
      Company profiles will appear here.
    </p>

  <% } %>
</section>

<!-- ABOUT SECTION -->
<section class="section" id="about">
  <h2>About Skill Nexa</h2>

  <p>
    A central place to explore career opportunities and connect
    with employers.
  </p>
</section>

<%- include('partials/footer') %>
