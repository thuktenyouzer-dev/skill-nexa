<%- include('../partials/header', { title }) %>
<section class="auth-card">
  <p class="eyebrow">Account recovery</p>
  <h1>Forgot your password?</h1>
  <p class="muted">Enter the email address associated with your account. If it exists, we will send a reset link.</p>
  <% if (message) { %><div class="notice notice-success"><%= message %></div><% } %>
  <% if (errors && errors.length) { %>
    <div class="notice notice-error" role="alert"><% errors.forEach((error) => { %><p><%= error %></p><% }); %></div>
  <% } %>
  <form action="/forgot-password" method="POST" class="form-stack">
    <div class="form-group">
      <label for="email">Email address</label>
      <input type="email" id="email" name="email" maxlength="254" placeholder="you@example.com" autocomplete="email" required />
    </div>
    <button type="submit">Send reset link</button>
  </form>
  <p class="auth-switch"><a href="/login">Back to sign in</a></p>
</section>
<%- include('../partials/footer') %>
