<%- include('../partials/header', { title }) %>
<section class="auth-card">
  <p class="eyebrow">Email verification</p>
  <h1>Resend verification link</h1>
  <p class="muted">Enter the email address you used to register. We will send a new verification link if the account exists and is still unverified.</p>

  <% if (message) { %>
    <div class="notice notice-success" role="status"><%= message %></div>
  <% } %>

  <% if (errors && errors.length) { %>
    <div class="notice notice-error" role="alert">
      <% errors.forEach((error) => { %><p><%= error %></p><% }); %>
    </div>
  <% } %>

  <form action="/resend-verification" method="POST" class="form-stack">
    <div class="form-group">
      <label for="email">Email address</label>
      <input id="email" name="email" type="email" maxlength="254" required autocomplete="email" />
    </div>
    <button type="submit">Send verification link</button>
  </form>
  <p class="auth-switch"><a href="/login">Back to sign in</a></p>
</section>
<%- include('../partials/footer') %>
