<%- include('partials/header', { title }) %>

<section class="section">
  <a class="text-link" href="/jobs">← Back to jobs</a>
  <article class="job-detail">
    <p class="eyebrow">Job opportunity</p>
    <h1><%= job.title %></h1>
    <h2><%= job.company_name %></h2>
    <p><strong>Location:</strong> <%= job.location %></p>
    <p><strong>Category:</strong> <%= job.category %></p>
    <p><strong>Employment type:</strong> <%= job.job_type %></p>
    <p><strong>Experience level:</strong> <%= job.experience_level || 'Not specified' %></p>
    <% if (job.salary_min != null || job.salary_max != null) { %>
      <p><strong>Salary:</strong>
        <%= job.salary_currency || 'BTN' %>
        <%= job.salary_min != null ? Number(job.salary_min).toLocaleString() : 'Not specified' %>
        –
        <%= job.salary_max != null ? Number(job.salary_max).toLocaleString() : 'Not specified' %>
      </p>
    <% } %>
    <p><strong>Application deadline:</strong> <%= job.deadline ? new Date(job.deadline).toLocaleDateString() : 'Not specified' %></p>

    <div class="job-description">
      <h3>Job description</h3>
      <p><%= job.description %></p>
    </div>

    <% if (job.company_description) { %>
      <div class="job-description">
        <h3>About the company</h3>
        <p><%= job.company_description %></p>
      </div>
    <% } %>
    <% if (job.company_website) { %>
      <p><strong>Company website:</strong> <a href="<%= job.company_website %>" target="_blank" rel="noopener noreferrer"><%= job.company_website %></a></p>
    <% } %>
  </article>
</section>

<%- include('partials/footer') %>
