<%- include('partials/header', { title }) %>

<section class="section">
  <a class="text-link" href="/jobs">← Back to jobs</a>
  <article class="job-detail">
    <p class="eyebrow">Job opportunity</p>
    <h1><%= job.title %></h1>
    <p><strong><%= job.company %></strong></p>
    <p><%= job.location %></p>
